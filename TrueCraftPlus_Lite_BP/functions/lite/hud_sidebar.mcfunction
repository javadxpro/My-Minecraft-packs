# TrueCraft+ LITE - fallback HUD on the SIDEBAR (use if the action bar
# does not render on your client). Run again to refresh live values.
scoreboard objectives setdisplay sidebar tc_temp ascending
tellraw @s {"rawtext":[{"text":"§2[TrueCraft+ LITE] §fTemperature now shown on the sidebar. §7Run /function lite/hud_off to hide it."}]}
